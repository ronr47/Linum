#!/usr/bin/env python3
"""PB-005: file-backed policy transitions with crash injection."""

import argparse
import json
import os
import sys
import tempfile
from pathlib import Path


class Reject(Exception):
    pass


def sync_directory(directory):
    """Request persistence of directory-entry changes."""
    fd = os.open(directory, os.O_RDONLY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def atomic_write(path, data):
    """Write a complete file and atomically replace its destination."""
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temp_name = tempfile.mkstemp(
        prefix=".pb005-", dir=str(path.parent)
    )
    temp = Path(temp_name)

    try:
        with os.fdopen(fd, "wb") as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())

        os.replace(temp, path)
        sync_directory(path.parent)
    finally:
        if temp.exists():
            temp.unlink()


def encode(policy):
    return (
        json.dumps(
            policy, sort_keys=True, separators=(",", ":")
        ) + "\n"
    ).encode("utf-8")


def validate(policy):
    if not isinstance(policy, dict):
        raise Reject("policy is not an object")

    if set(policy) != {"generation", "key"}:
        raise Reject("unexpected policy fields")

    if type(policy["generation"]) is not int:
        raise Reject("invalid generation type")

    if policy["generation"] < 1:
        raise Reject("invalid generation")

    if not isinstance(policy["key"], str) or not policy["key"]:
        raise Reject("invalid release key")

    return policy


def read_policy(path):
    try:
        policy = json.loads(Path(path).read_text("utf-8"))
    except (OSError, UnicodeError, ValueError) as exc:
        raise Reject(f"cannot read policy: {exc}") from exc

    return validate(policy)


def initialize(root):
    root = Path(root)
    root.mkdir(parents=True, exist_ok=True)
    committed = root / "committed.json"

    if committed.exists():
        raise Reject("store already initialized")

    atomic_write(
        committed,
        encode({"generation": 1, "key": "release-A"}),
    )
    print("Initialized generation 1")


def recover(root):
    """Only committed.json is authoritative; pending is never promoted."""
    root = Path(root)
    return read_policy(root / "committed.json")


def update(root, new_key, crash_after=None):
    root = Path(root)
    committed_path = root / "committed.json"
    pending_path = root / "pending.json"

    old = recover(root)
    new = {
        "generation": old["generation"] + 1,
        "key": new_key,
    }
    validate(new)

    # Stage 1: persist the inactive candidate.
    atomic_write(pending_path, encode(new))
    crash(crash_after, "pending")

    # Stage 2: validate the candidate before commit.
    candidate = read_policy(pending_path)
    if candidate["generation"] != old["generation"] + 1:
        raise Reject("generation transition invalid")
    crash(crash_after, "validated")

    # Stage 3: atomically replace the authoritative record.
    atomic_write(committed_path, encode(candidate))
    crash(crash_after, "committed")

    # Stage 4: remove the now-unneeded candidate.
    pending_path.unlink(missing_ok=True)
    sync_directory(root)
    crash(crash_after, "cleanup")

    return recover(root)


def crash(requested, stage):
    # os._exit simulates abrupt process termination without Python cleanup.
    if requested == stage:
        os._exit(77)


def main():
    parser = argparse.ArgumentParser()
    sub = parser.add_subparsers(dest="command", required=True)

    init_parser = sub.add_parser("init")
    init_parser.add_argument("store")

    update_parser = sub.add_parser("update")
    update_parser.add_argument("store")
    update_parser.add_argument("--key", required=True)
    update_parser.add_argument(
        "--crash-after",
        choices=("pending", "validated", "committed", "cleanup"),
    )

    check_parser = sub.add_parser("check")
    check_parser.add_argument("store")

    args = parser.parse_args()

    try:
        if args.command == "init":
            initialize(args.store)
        elif args.command == "update":
            result = update(
                args.store, args.key, args.crash_after
            )
            print(json.dumps(result, sort_keys=True))
        else:
            print(json.dumps(recover(args.store), sort_keys=True))
    except (Reject, OSError, ValueError) as exc:
        print(f"PB-005 REJECT: {exc}", file=sys.stderr)
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
