#!/usr/bin/env bash
set -euo pipefail

CMD="${1:-help}"

case "$CMD" in
    up)
        echo "[*] Phase 1: Running Z3 SMT Invariant Proof Verification..."
        for smt in *.smt2; do
            if [ -f "$smt" ]; then
                echo -n "  • Verifying $smt: "
                z3 -- "$smt" 2>/dev/null || z3 "$smt" || echo "[X] Proof failed!"
            fi
        done
        
        echo "[*] Phase 2: Building core artifacts and verifying toolchains..."
        if [ -f "build.sh" ]; then
            ./build.sh || true
        fi
        
        echo "[*] Phase 3: Launching Dual-Core Split Affinity Runtime..."
        sudo pkill -f "linums" 2>/dev/null || true
        sudo pkill -f "kestrel" 2>/dev/null || true
        
        # Core 0: Injector, Core 1: Auditor
        sudo taskset -c 0 chrt -f 99 ./kestrel jit 42 100 >/dev/null 2>&1 &
        echo "[+] Kestrel JIT active on Core 0."
        echo "[+] Launching Latency Auditor on Core 1..."
        sudo taskset -c 1 chrt -f 99 ./linums audit 10000 9999 1.1
        ;;
        
    audit)
        echo "[*] Running full T0-T4 Latency & Telemetry Suite..."
        if [ -x "./run_split_core_audit.sh" ]; then
            ./run_split_core_audit.sh
        else
            ./linums audit 10000 9999 1.1
        fi
        ;;
    
    metal)
        echo "[*] Packaging and Booting Microkernel via GRUB ISO (QEMU)..."
        if [ -f "kernel.elf" ]; then
            rm -rf iso_root
            mkdir -p iso_root/boot/grub
            cp kernel.elf iso_root/boot/kernel.elf
            
            cat << 'GRUBEOF' > iso_root/boot/grub/grub.cfg
set timeout=0
set default=0
menuentry "Linum Microkernel" {
    multiboot /boot/kernel.elf
    boot
}
GRUBEOF

            if command -v grub-mkrescue >/dev/null 2>&1 && command -v xorriso >/dev/null 2>&1; then
                echo "[*] Running grub-mkrescue..."
                grub-mkrescue -o linum_boot.iso iso_root
                echo "[*] Launching QEMU..."
                qemu-system-x86_64 -cdrom linum_boot.iso -nographic
            else
                echo "[X] Missing dependencies! Please ensure 'xorriso' and grub tools are installed:"
                echo "    sudo apt-get install xorriso grub-pc-bin"
            fi
        else
            echo "[X] kernel.elf not found."
        fi
        ;;
        
    *)
        echo "=================================================================="
        echo "  LINUMCTL: THE UNIFIED ORCHESTRATOR"
        echo "=================================================================="
        echo "Usage:"
        echo "  ./linumctl up      - Verify SMT proofs, build, and run dual-core pinning"
        echo "  ./linumctl audit   - Run T0-T4 latency audit suite"
        echo "  ./linumctl metal   - Boot freestanding kernel via QEMU"
        echo "=================================================================="
        ;;
esac
