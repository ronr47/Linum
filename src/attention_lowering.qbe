# ~/linum/src/attention_lowering.qbe // Micro-Kernel Architecture Intermediate Representation
# Target Profile: Zero-Overhead Cache-Line Aligned Memory Stream

export function s $linum_qbe_dot_product(w %q_ptr, w %k_ptr, w %dim) {
@start
    %acc =s copy s_0.0
    %idx =w copy 0
@loop
    %cond =w csltw %idx, %dim
    jnz %cond, %body, %end
@body
    # Calculate explicit 64-bit word offsets manually to prevent memory striding stalls
    %q_off =w mul %idx, 4
    %k_off =w mul %idx, 4
    
    %q_addr =l add %q_ptr, %q_off
    %k_addr =l add %k_ptr, %k_off
    
    %q_val =s loads %q_addr
    %k_val =s loads %k_addr
    
    %prod =s mul %q_val, %k_val
    %acc =s add %acc, %prod
    
    %idx =w add %idx, 1
    jmp %loop
@end
    ret %acc
}
